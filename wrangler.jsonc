{
  "name": "celld-boilerplate",
  "main": "./celld/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./src",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
