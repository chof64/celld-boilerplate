{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/pages/**/*.tsx",
    "src/components/**/*.tsx",
    "src/lib/**/*.ts",
    "src/waku.server.tsx",
    "waku.config.ts"
  ],
  "exclude": [
    "src/api/**"
  ]
}
